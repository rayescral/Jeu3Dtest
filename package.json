{
  "name": "tennis-club-simulator",
  "private": true,
  "description": "Jeu de gestion de club de tennis et de padel en 3D, à la première personne.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --minify --target=es2020 --legal-comments=none --outfile=jeu.js",
    "start": "python3 -m http.server 8000",
    "test": "node tests/simulation.test.mjs && node tests/paths.test.mjs",
    "app": "npm run build && node tools/package-app.mjs",
    "itch": "npm run build && node tools/package-itch.mjs"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.2",
    "esbuild": "0.24.0",
    "three": "^0.170.0"
  }
}
